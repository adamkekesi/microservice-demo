# Copy to .env and adjust. Used by docker-compose.

# --- Datadog ---
# Without a real key the agent still runs, but traces/metrics won't reach
# Datadog. The apps work regardless.
DD_API_KEY=
DD_ENV=dev
DD_VERSION=1.0.0
DD_PROFILING_ENABLED=false

# --- Postgres (compose) ---
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics

# --- Auth seed admin (created on first boot if no admin exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# --- Auth signing ---
JWT_ISSUER=auth-service
JWT_KEY_ID=auth-key-1
JWT_TTL_SECONDS=900

# --- Inventory ---
RESERVATION_TTL_SECONDS=900

# --- Shipment ---
INVENTORY_TIMEOUT_MS=5000
